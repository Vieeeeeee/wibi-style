  "welcome": {
    "waiting": [
      "先发一张餐桌照片给我吧～餐厅打卡、家里做的、外卖拆开的都行。",
      "整桌或单盘都可以，能看清菜和器皿就够。我会自己挑主角、重新构图，把背景换成红底复古杂志质感。",
      "默认出 3:4 竖图、复古印刷红底；想换底色或比例，发照片时顺手说一句。"
    ],
    "received": [
      "照片收到啦～我先看这一桌谁最适合当主角、留白该放哪一侧，然后直接开始，不再多问。",
      "想指定某道菜当主角，或者想换个底色，现在说还来得及。"
    ]
  },
  "input": {
    "type": "single-photo-restyle",
    "subject": "餐桌照片、餐厅打卡照、外卖照",
    "bundled_references": 2,
    "output_ratio": "3:4"
  },
  "references": [
    {
      "file": "assets/references/01_多器皿红底静物.jpg",
      "role": "多件器皿在红底上的排布节奏、前后层次、金属与玻璃反光、器皿之间的投影关系；适合一整桌、两道以上菜、或主菜之外还有值得保留的杯碟酒瓶。",
      "source": "01_风格参考/01_多器皿红底静物.jpg",
      "source_sha256": "209c982b654c1504f5574f7b8cd494c6cd85d388210750c9e52a5d31c6af5ee8"
    },
    {
      "file": "assets/references/02_单主体红底特写.jpg",
      "role": "单个主体在大面积红底里的存在感、干净轮廓、克制投影、大留白呼吸；适合只有一道菜、一碗、一杯，或只有一件值得当主角。",
      "source": "01_风格参考/02_单主体红底特写.jpg",
      "source_sha256": "8300764c165c6dc312ee6d2ec2a4046346d3b87790dab3c71232871de22bfd7e"
    }
  ],
  "reference_routing": "默认只带一张；两种情况都沾边时选 01；一张明显不够时才两张同带并说明各自职责。",
  "post_process": {
    "command": "python3 {skill_dir}/scripts/vintage_finish.py {generated_image}",
    "purpose": "印刷质感收尾：降解析力、光学柔化、网点颗粒、动态范围压缩，不动颜色",
    "required": false,
    "strength": "auto（脚本自己量锐度、二分搜强度；不同模型出图锐度差很多，写死会失效）",
    "optional_dependency": "Pillow",
    "on_missing_dependency": "skip-and-show-original",
